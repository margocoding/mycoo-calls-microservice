HOST=127.0.0.1
PORT=4200
# Same private service credential in the main API. Generate a random value (32+ characters).
CALLS_SERVICE_SECRET=
LIVEKIT_URL=http://127.0.0.1:7880
# Browser-reachable URL, wss:// in production.
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Private main API endpoint for signed LiveKit events.
MYCOO_EVENTS_URL=http://127.0.0.1:4193/api/meetings/events
# Optional recording storage. Bucket must be private.
RECORDINGS_S3_ENDPOINT=
RECORDINGS_S3_REGION=us-east-1
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_ACCESS_KEY=
RECORDINGS_S3_SECRET_KEY=
# Cloud recognition. Requires a Yandex Cloud billing account and service account.
SPEECH_PROVIDER=yandex
# API key for a service account with ai.speechkit-stt.user; never expose to the browser.
YANDEX_SPEECHKIT_API_KEY=
# Optional cloud alternative: SPEECH_PROVIDER=salute.
# SaluteSpeech authorization key, NOT a GigaChat key or an access token.
SALUTE_SPEECH_CREDENTIALS=
SALUTE_SPEECH_SCOPE=SALUTE_SPEECH_PERS
# Optional absolute path to ffmpeg (installed in the Docker image).
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Trusted public CA bundle for Sber endpoints; set before starting Node.
NODE_EXTRA_CA_CERTS=./certs/russian_trusted_root_ca_pem.crt
